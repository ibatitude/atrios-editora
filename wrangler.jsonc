{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atrios-editora",
  "compatibility_date": "2026-08-28",

  // Projeto do Cloudflare Pages: só assets estáticos, sem Pages Functions.
  // Com este campo presente, o arquivo passa a ser a fonte de verdade da
  // configuração — o painel mostra, mas não deixa editar.
  // O out/404.html (gerado de app/not-found.tsx) o Pages serve sozinho
  // em rota não encontrada, com status 404.
  "pages_build_output_dir": "./out"
}
