# URL pública canônica do site, sem barra no final.
# Usada por lib/seo.ts para gerar <link rel="canonical">, as URLs absolutas de
# Open Graph e o sitemap.xml. Sem esta variável o build cai no fallback
# https://atrioseditora.com.br — o que quebra canonical/sitemap em preview.
NEXT_PUBLIC_SITE_URL="https://atrioseditora.com.br"

# Subpasta em que o site é servido, com barra inicial e sem barra final.
# Só é necessária em GitHub Pages de projeto (ibatitude.github.io/atrios-editora).
# Deixe vazia para domínio próprio ou Cloudflare, que servem na raiz.
NEXT_PUBLIC_BASE_PATH=""

# Marca o build inteiro como noindex. Use nos deploys de endereço temporário
# (ex.: github.io) para o Google não indexar URLs que serão abandonadas.
NEXT_PUBLIC_NOINDEX=""
